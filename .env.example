# Backend v2

# General
APP_ENV=local or docker #local if running locally on the machine; docker if running in a docker container

# MongoDB
MONGO_URL=mongodb://mongodb:27017
MONGO_DB_NAME=

# auth-service (issues tokens; this backend only verifies them against its JWKS).
# Running this backend directly (not in Docker): http://localhost:8100
# Running this backend via Backend/docker-compose.yml, with auth-service's own
# compose stack also running on the same host: http://host.docker.internal:8100
AUTH_SERVICE_URL=http://localhost:8100


# LLM Provider Defaults
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_EMBEDDINGS_MODEL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ragulate-rag (Backend/ragulate-rag/) — optional; chat still works without
# it, just without retrieval, if unset or unreachable.
# Running this backend directly (not in Docker): http://localhost:8181
# Running via Backend/docker-compose.yml: http://ragulate-rag:8081
RAGULATE_RAG_URL=http://localhost:8181
# ragulate-rag warms up its engine (embeddings, Neo4j, local reranker model)
# on its own startup, but give this some headroom for slower/GPU-less hosts.
RAGULATE_RAG_TIMEOUT=60