# Backend v2

# General
APP_ENV=local or docker #local if running locally on the machine; docker if running in a docker container

# MongoDB
MONGO_URL=mongodb://mongodb:27017
MONGO_DB_NAME=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# LLM Provider Defaults
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_EMBEDDINGS_MODEL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# LightRAG Settings
LIGHTRAG_WORKING_DIR=/tmp/lightrag
# Embedding dimension must match the model used (1536 for text-embedding-ada-002 / text-embedding-3-small)
LIGHTRAG_EMBEDDING_DIM=1536
# RAG retrieval mode: naive | local | global | hybrid
LIGHTRAG_RAG_MODE=hybrid