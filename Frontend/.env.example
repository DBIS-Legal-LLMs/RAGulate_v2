# auth-service. Register calls it directly from the browser (this value is
# compiled in at build time).
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8100

# auth-service as the frontend's own server reaches it, for login, token
# refresh and logout (the /api/session routes). Read at runtime; defaults to
# NEXT_PUBLIC_AUTH_SERVICE_URL. In Docker use the service name, e.g.
# http://auth-service:8000.
# AUTH_SERVICE_URL=http://localhost:8100

# RAGulate's own chat/folder backend (existing var, documented here since
# it was previously undocumented and hardcoded in several components).
NEXT_PUBLIC_API_BACKEND=http://localhost:8000
